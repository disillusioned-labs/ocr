# Docker Compose overrides.
#
# Base configuration comes from .env.
# This file only changes addresses that must resolve through the
# Docker Compose networks instead of localhost.

# --- postgres / redis / kafka / storage ------------------------------------
OCR_DATABASE_DSN=postgres://ocr_app:devpassword@data-postgres:5432/ocr
OCR_REDIS_URL=redis://data-redis:6379/0
OCR_KAFKA_BROKERS=messaging-kafka:19092
STORAGE_ENDPOINT_URL=http://data-seaweedfs:8333

# --- opentelemetry ----------------------------------------------------------
# Reached through the shared observability Docker network using the
# collector's service name - same central collector every service pushes to.

OTEL_EXPORTER_OTLP_ENDPOINT=http://observability-otel-collector:4317
