# Every setting the app reads, written exactly as a deployment sets it.
#   cp .env.example .env   # local development; .env is git-ignored
# Precedence: real environment variable > .env > built-in default.
# All knobs are validated at boot; a wrong combination fails fast with the
# full problem list. Reference: docs/explanation/ocr/provider-config.md.
#
# Vocabulary matches the Go services: domain knobs carry the OCR_ prefix,
# the shared platform knobs (SERVICE_*, LOG_*) and the OpenTelemetry spec
# names (OTEL_*) are unprefixed so one deployment mechanism can set the same
# variable for every service. docker compose layer .env.compose on top - it
# swaps localhost addresses for the compose network names.

# --- required ---------------------------------------------------------------
OCR_DATABASE_DSN=postgres://ocr_app:devpassword@localhost:5432/ocr
OCR_KAFKA_BROKERS=localhost:9092
# Buckets this service may read with its read-only credentials. Boot fails
# when empty on purpose - a silent empty allowlist reads nothing, forever.
OCR_ALLOWED_BUCKETS=expense-files

# --- storage (read-only S3/MinIO credentials, scoped to the buckets above) --
OCR_STORAGE_ENDPOINT_URL=http://localhost:9000
OCR_STORAGE_ACCESS_KEY_ID=
OCR_STORAGE_SECRET_ACCESS_KEY=
OCR_STORAGE_REGION=us-east-1

# --- limits -----------------------------------------------------------------
OCR_MAX_FILE_BYTES=26214400
OCR_MAX_PAGES=10
OCR_MAX_IMAGE_DIM=4000
OCR_WORKER_CONCURRENCY=8
# Override the OCR-stage semaphore (defaults to max(1, cores/2))
#OCR_SEMAPHORE_OVERRIDE=2
# ProcessDocument (synchronous RPC) rejects declared sizes above this; larger
# files must go through the queue. Must not exceed OCR_MAX_FILE_BYTES.
OCR_SYNC_MAX_BYTES=10485760

# --- api --------------------------------------------------------------------
OCR_GRPC_PORT=9094

# --- provider (docs/explanation/ocr/provider-config.md) ---------------------
OCR_PROVIDER=baidu_aistudio
OCR_BAIDU_MODE=sync
# Sync endpoint (from the AI Studio PaddleOCR task page); required in sync mode.
OCR_BAIDU_API_URL=https://<app-id>.aistudio-app.com/layout-parsing
# Async jobs base; required (and only used) in async mode.
OCR_BAIDU_ASYNC_URL=https://paddleocr.aistudio-app.com
# Secret. Never logged. Rotate from the AI Studio account page.
OCR_BAIDU_TOKEN=
OCR_BAIDU_UNWARP=true
OCR_BAIDU_POLL_INTERVAL=5
OCR_BAIDU_POLL_TIMEOUT=300

# --- service ----------------------------------------------------------------
SERVICE_NAME=ocr
# SERVICE_ENV: development | staging | production
SERVICE_ENV=development

# --- log --------------------------------------------------------------------
# Defaults are the production-safe set (info, json); the values below are the
# dev-only convenient ones. level: debug | info | warning | error
#                                        format: text | json
LOG_LEVEL=debug
LOG_FORMAT=text

# --- opentelemetry (spec names, spec meaning) --------------------------------
# Requires a scheme - the scheme selects TLS (http:// is the local collector).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# Turn everything off with one variable.
OTEL_SDK_DISABLED=false
# MILLISECONDS, per the OTel spec - not a duration like the Baidu knobs.
# 15000 is 15s, matching the Go services' dev interval.
OTEL_METRIC_EXPORT_INTERVAL=15000
